{
  "schema": 1,
  "components": [
    {
      "id": "xinhan_cam",
      "kind": "app",
      "path": "apps/xinhan_cam",
      "manifest": "app.json",
      "icon": "icon.png",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "xinhan-cam": "0.6.1",
        "idrive7-renderd": "2.1.7",
        "mgu-inputgate": "1.0.0"
      },
      "build": {
        "python": "kit/tools/build.py",
        "args": [
          "--language",
          "vi",
          "--plain-version",
          "{id}"
        ],
        "sdk": "oap-sdk",
        "output": "dist/{id}@{version}.tgz",
        "shared": [
          "kit/runtime",
          "kit/platform",
          "kit/localization",
          "kit/tools/build.py",
          "kit/tools/pack_data.py",
          "kit/tools/localize.py",
          "kit/tools/locale-revisions.json",
          "kit/tools/oapgen",
          "oap-sdk"
        ]
      }
    }
  ],
  "tools": [
    {
      "id": "xinhan-cam",
      "path": "tools/xinhan-cam",
      "title": "Trợ thủ Camera xi nhan",
      "mguHmi": [
        "ID7"
      ]
    },
    {
      "id": "xinhan-cam-log",
      "path": "tools/xinhan-cam-log",
      "title": "Nhật ký Camera xi nhan",
      "mguHmi": [
        "ID7"
      ]
    }
  ]
}