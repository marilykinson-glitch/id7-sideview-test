# xinhan-cam: the mirror camera of the side whose turn signal is on, in the instrument cluster
# (tools/xinhan-cam/xinhan-cam.js starts the decoder mgu-sidecam and does what the app Camera xi nhan says).
[Unit]
Description=Camera xi nhan: mirror camera on the instrument cluster with the turn signal (xinhan-cam)
After=ufipc_daemon.service avbstreamhandler.service cluster-render.socket
RequiresMountsFor=/var/opt
StartLimitIntervalSec=0

[Service]
# root: the head unit's camera stream (the IAS AVB bridge) is root's, as is the app's control file
User=root
RuntimeDirectory=xinhan-cam
RuntimeDirectoryMode=0755
# below the HMI and the car's own services: decoding never takes time from the screen
Nice=5
ExecStart=/bin/sh -c 'exec "$(command -v node || echo /usr/bin/node)" /var/opt/xinhan-cam/current/xinhan-cam.js run'
# the car's system.conf has DefaultStandardOutput=null: the log would never reach the journal
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
