# anh-dai-dien: the web page the owner's phone uses to put its own pictures in the profile picker
# (tools/anh-dai-dien/anh-dai-dien.js; the bundle is written through wbm.js).
[Unit]
Description=ID Studio: own pictures on the head unit, from a phone (anh-dai-dien)
RequiresMountsFor=/var/opt /mnt/dataro
After=local-fs.target network.target
StartLimitIntervalSec=0

[Service]
# root: the picture bundle is on a read-only partition this remounts for a moment, and the port is open to the phone
User=root
RuntimeDirectory=anh-dai-dien
RuntimeDirectoryMode=0755
Nice=5
ExecStart=/bin/sh -c 'exec "$(command -v node || echo /usr/bin/node)" /var/opt/anh-dai-dien/current/anh-dai-dien.js run'
# the firewall rule this keeps while it runs goes with it, however it ended
ExecStopPost=-/bin/sh -c 'exec "$(command -v node || echo /usr/bin/node)" /var/opt/anh-dai-dien/current/anh-dai-dien.js fwclose'
# the car's system.conf has DefaultStandardOutput=null: the log would never reach the journal
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=3
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
