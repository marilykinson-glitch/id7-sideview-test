# thoi-tiet: fetches the weather forecast for the Thời tiết app and serves the phone's page for searching places (tools/thoi-tiet/thoi-tiet.js).
[Unit]
Description=Thời tiết: forecast for the weather app (thoi-tiet)
RequiresMountsFor=/var/opt
After=local-fs.target network.target ufipc_daemon.service
StartLimitIntervalSec=0

[Service]
User=root
RuntimeDirectory=thoi-tiet
RuntimeDirectoryMode=0755
Nice=10
ExecStart=/bin/sh -c 'exec "$(command -v node || echo /usr/bin/node)" /var/opt/thoi-tiet/current/thoi-tiet.js run'
# the firewall rule this keeps while it runs goes with it
ExecStopPost=-/bin/sh -c 'exec "$(command -v node || echo /usr/bin/node)" /var/opt/thoi-tiet/current/thoi-tiet.js fwclose'
# the car's system.conf has DefaultStandardOutput=null: the log would never reach the journal
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=5
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
